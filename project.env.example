# Copy to project.env and fill in. bootstrap-ubuntu.sh renders {{KEY}} placeholders in the installed templates from this file.
# Keys you leave out stay as {{PLACEHOLDERS}} for the Gate Keeper to settle (see PORTING-CHECKLIST.md). NO SECRETS HERE.
PROJECT=cleanisense
PROJECT_DIR=$HOME/cleanisense
OPERATOR=Alex Example
OPERATOR_HANDLE=alex
TZ=America/New_York
PEER_TEAM=the other team
MAIN_BRANCH=main
BASE_BRANCH=main
TRACKER=Mantis
TRACKER_MCP=mantis-mcp
DONE_STATUS=feedback
TRACKER_CLAIM_CALL=update_issue_status assigned + assign_to:"alex"
BOARD_URL=(set after publishing the board artifact)
MEMORY_PROJECT_ID=cleanisense
BACKEND_REPO=cleanisense-backend
MOBILE_REPOS=cleanisense-ios, cleanisense-android
SHARED_CODE_PATHS=libs/common
HIGH_BLAST_PATHS=billing, payments, auth, migrations
PRE_PUSH_CHECK=your pre-push gate (lint/typecheck)
HEAVY_TEST_WRAPPER=tools/heavy-test.sh
MERGE_PLAN_DOC=.planning/MERGE-DEPLOY-PLAN.md
PLANS_DIR=.planning/
MONEY_LENS=money and billing
STANDING_EXCEPTION=read-only cloud log queries and deploy-metadata reads by GK and Deploys
DEPLOY_TOOL=your deploy script
DEPLOY_WINDOW_MECHANISM=memory-service lease or a lock file
GRANT_DATE=(date the operator granted it)
PUBLISH_DATE=(date the board was published)
CLASS_TRACKER_RANGE=(ticket range, or delete the lane)
